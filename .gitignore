# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.next-dev/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local scratch work and generated document previews/exports
# Keep reusable assets in public/, and research evidence in scripts/fixtures/.
# Do not ignore *.json or scripts/fixtures/: builders and tests read curated
# selections, exclusions, source games, validation data and mate certificates.
# Even generated *published.json files are consumed by regression tests.
/tmp/
/temp/
/output/
/outputs/

# Interrupted atomic writes from research builders; final JSON evidence stays tracked.
/scripts/fixtures/**/*.tmp

# One-off local render harnesses (reusable scripts/render-* stay tracked).
/scripts/.render-*.cjs
/scripts/.render-*.mjs
/scripts/.scratch/

# Atomic saved-game writes; the saved-games.json collection itself is required.
/src/lib/server/saved-games.json.lock
/src/lib/server/saved-games.json.*.tmp

# Python research-tool caches and local environments
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/

# browser-test reports and temporary test artifacts
/playwright-report/
/test-results/
/blob-report/

# editor/OS temporary files (keep shared editor settings tracked)
*.swp
*.swo
*~
Thumbs.db
